                            <exclude>com.gardensmc.gardensplayers:*</exclude>
                            <exclude>com.gardensmc.gardensfurniture:*</exclude>
                        </excludes>
                    </artifactSet>
                </configuration>
            </plugin>
        </plugins>
    </build>

