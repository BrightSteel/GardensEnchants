                        <excludes>
                            <exclude>com.codingforcookies.armorequip:*</exclude>
                            <exclude>net.william278:*</exclude>
                            <exclude>com.sk89q.worldguard:*</exclude>
                            <exclude>com.comphenix.protocol:*</exclude>
                            <exclude>net.momirealms.customcrops:*</exclude>
